{
    "manifest_version": 3,
    "name": "Joblens AI",
    "version": "1.0.0",
    "description": "AI-powered ATS job comparison extension",
    "action": {
        "default_popup": "index.html"
    }, 
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": ["https://www.linKedin.com/*"],
    "content-scripts": [
        {
            "matches": ["https://www.linkedin.com/jobs/*"],
            "js": ["src/content/linkedinScraper.ts"]

        }
    ]
}